{
  "version": "1.0",
  "rules": [
    {
      "id": "virtual_object_source_rule",
      "rule": "虚拟地点、虚拟项目名称不得作为真实资料收集、现场调研、运行数据来源",
      "conversion": [
        "相关系统资料",
        "设备资料",
        "行业标准",
        "技术规范",
        "典型案例资料"
      ],
      "patterns": [
        "收集X站...相关资料/资料/数据",
        "调研X站...实际情况",
        "获取X站...运行数据",
        "分析X站...设备/系统/装置"
      ],
      "effective": true
    },
    {
      "id": "artifact_clean_rule",
      "rule": "复制替换残留自动清理并记录",
      "examples": [
        "轨道交通车辆轨道交通 -> 轨道交通"
      ],
      "effective": true
    }
  ]
}